{
  "name": "tarefas-comsoc",
  "version": "0.3.0",
  "description": "Gestão de projetos leve: escopo, cronograma, orçamento, indicadores (SPI/CPI), diário de bordo e Gantt. TypeScript + Supabase.",
  "author": "Cezar Tosta",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Cezar-Tosta/tarefas_comsoc.git"
  },
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "format": "oxfmt",
    "check": "pnpm typecheck && pnpm lint && pnpm test"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.119.0"
  },
  "devDependencies": {
    "@types/node": "22.20.3",
    "oxfmt": "0.77.0",
    "oxlint": "1.92.0",
    "typescript": "7.0.2",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  },
  "packageManager": "pnpm@12.3.4"
}
